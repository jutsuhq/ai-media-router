{
  "source": "fal queue docs: submit returns status_url/response_url built from owner/app only; ids and URLs invented.",
  "model": "fal-ai/flux/schnell",
  "input": {
    "prompt": "a red fox"
  },
  "exchanges": [
    {
      "step": "submit",
      "request": {
        "method": "POST",
        "url": "https://queue.fal.run/fal-ai/flux/schnell",
        "headers": {
          "authorization": "Key <FAL_KEY>"
        },
        "body": {
          "prompt": "a red fox"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "request_id": "764cabcf",
          "response_url": "https://queue.fal.run/fal-ai/flux/requests/764cabcf",
          "status_url": "https://queue.fal.run/fal-ai/flux/requests/764cabcf/status",
          "cancel_url": "https://queue.fal.run/fal-ai/flux/requests/764cabcf/cancel"
        }
      }
    },
    {
      "step": "poll",
      "request": {
        "method": "GET",
        "url": "https://queue.fal.run/fal-ai/flux/requests/764cabcf/status"
      },
      "response": {
        "status": 200,
        "body": {
          "status": "IN_QUEUE",
          "queue_position": 2
        }
      }
    },
    {
      "step": "poll",
      "request": {
        "method": "GET",
        "url": "https://queue.fal.run/fal-ai/flux/requests/764cabcf/status"
      },
      "response": {
        "status": 200,
        "body": {
          "status": "COMPLETED",
          "logs": null
        }
      }
    },
    {
      "step": "result",
      "request": {
        "method": "GET",
        "url": "https://queue.fal.run/fal-ai/flux/requests/764cabcf"
      },
      "response": {
        "status": 200,
        "body": {
          "images": [
            {
              "url": "https://v3.fal.media/files/fox.jpg",
              "width": 1024,
              "height": 768,
              "content_type": "image/jpeg"
            }
          ],
          "seed": 42
        }
      }
    }
  ],
  "expect": {
    "outputs": [
      "https://v3.fal.media/files/fox.jpg"
    ]
  }
}
