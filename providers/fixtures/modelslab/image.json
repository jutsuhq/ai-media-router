{
  "source": "ModelsLab v6 text2img docs: processing and success example responses.",
  "model": "images/text2img",
  "input": {
    "model_id": "flux",
    "prompt": "a lighthouse",
    "width": 512,
    "height": 512,
    "samples": 1
  },
  "env": {
    "MODELSLAB_API_KEY": "<MODELSLAB_API_KEY>"
  },
  "exchanges": [
    {
      "step": "submit",
      "request": {
        "method": "POST",
        "url": "https://modelslab.com/api/v6/images/text2img",
        "body": {
          "key": "<MODELSLAB_API_KEY>",
          "model_id": "flux",
          "prompt": "a lighthouse",
          "width": 512,
          "height": 512,
          "samples": 1
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": "processing",
          "id": 12345678,
          "eta": 10,
          "message": "Your request is being processed"
        }
      }
    },
    {
      "step": "poll",
      "request": {
        "method": "POST",
        "url": "https://modelslab.com/api/v6/images/fetch",
        "body": {
          "key": "<MODELSLAB_API_KEY>",
          "request_id": 12345678
        }
      },
      "response": {
        "status": 200,
        "body": {
          "status": "success",
          "generationTime": 2.45,
          "id": 12345678,
          "output": [
            "https://pub-3626123a908346a7a8be8d9295f44e26.r2.dev/generations/abc123.png"
          ],
          "proxy_links": {
            "0": "https://cdn.modelslab.com/generations/abc123.png"
          },
          "meta": {
            "prompt": "a lighthouse",
            "model_id": "flux",
            "width": 512,
            "height": 512,
            "seed": 12345
          }
        }
      }
    }
  ],
  "expect": {
    "outputs": [
      "https://pub-3626123a908346a7a8be8d9295f44e26.r2.dev/generations/abc123.png"
    ]
  }
}
